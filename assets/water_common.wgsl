// Physical constants
const GRAVITY: f32 = 9.81;
const TIME_MULT: f32 = 3.0;
const TAU: f32 = 6.283185307179586;

// Uniform structs
struct WaterSettings {
    height_scale: f32,
    time_scale: f32,
    delta_time: f32,
    elapsed_time: f32,
}

struct WaterDebugSettings {
    spawn_center_x: f32,
    spawn_center_z: f32,
    radius: f32,
    scale: f32,
    inject: f32,
    _padding_a: f32,
    _padding_b: f32,
    _padding_c: f32,
}

struct VoxelSettings {
    water_to_voxel: mat4x4<f32>,  // Transform water grid to voxel
    voxel_size: f32,
    grid_dims: vec3<u32>,
}

struct WaterWaveGroupSpeeds{
    wave_group_speeds: array<vec4<f32>,1>,
}

// Helper functions
fn index_to_radians(i: u32) -> f32 {
    return (f32(i)+0.5) * (TAU / f32(DIRECTIONS));
}

fn layer_index(theta_index: u32, zeta_index: u32) -> i32 {
    return i32(zeta_index * DIRECTIONS + theta_index);
}
